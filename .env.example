# Copy to .env and fill in. Never commit .env.

# AgentMail (https://console.agentmail.to)
AGENTMAIL_API_KEY=
# Full inbox address, e.g. uarb-agent@agentmail.to
AGENTMAIL_INBOX=

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# OCI Object Storage, S3-compatible API (Customer Secret Key)
OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET=uarb-agent-zips
OCI_ACCESS_KEY=
OCI_SECRET_KEY=

# Feasibility checks only: where test emails are sent (your own address)
TEST_RECIPIENT=
